{:tasks
 {:test {:doc "Run the test suite: bb test/run_tests.bb"
         :task (apply clojure.core/exec "bb" ["test/run_tests.bb"])}

  :lint {:doc "Lint .bb files with clj-kondo (requires clj-kondo on PATH)"
